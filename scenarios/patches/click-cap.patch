@@ -0,0 +1,51 @@
+using UrlShortener.Application.Abstractions;
+using UrlShortener.Domain;
+
+namespace UrlShortener.UnitTests.Domain;
+
+public class ClickCapTests
+{
+    private static readonly DateTimeOffset Now = new(2026, 10, 22, 12, 0, 0, TimeSpan.Zero);
+
+    [Theory]
+    [InlineData(0)]
+    [InlineData(-5)]
+    [InlineData(ShortLink.MaxClicksLimit + 1)]
+    public void Max_clicks_outside_range_is_rejected(int maxClicks)
+    {
+        var result = ShortLink.Create(Code(), Url(), "hash", Now, null, false, maxClicks);
+
+        Assert.Equal(DomainErrors.Link.MaxClicksRange, result.Error);
+    }
+
+    [Fact]
+    public void Uncapped_link_is_never_exhausted()
+    {
+        var link = ShortLink.Create(Code(), Url(), "hash", Now, null, false).Value;
+
+        Assert.Null(link.MaxClicks);
+        Assert.False(link.IsExhausted);
+        Assert.True(link.EnsureResolvable(Now).IsSuccess);
+    }
+
+    [Fact]
+    public void Route_at_its_cap_is_gone_with_exhausted_error()
+    {
+        var route = new LinkRoute(Guid.NewGuid(), "capped", new Uri("https://example.com"), null, null, MaxClicks: 2, ClickCount: 2);
+
+        Assert.Equal(DomainErrors.Link.Exhausted, route.EnsureResolvable(Now).Error);
+    }
+
+    [Fact]
+    public void Route_below_its_cap_resolves()
+    {
+        var route = new LinkRoute(Guid.NewGuid(), "capped", new Uri("https://example.com"), null, null, MaxClicks: 2, ClickCount: 1);
+
+        Assert.True(route.EnsureResolvable(Now).IsSuccess);
+        Assert.True(route.IsCapped);
+    }
+
+    private static ShortCode Code() => ShortCode.Create("capped-link").Value;
+
+    private static DestinationUrl Url() => DestinationUrl.Create("https://example.com").Value;
+}

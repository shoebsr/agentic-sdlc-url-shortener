+using System.Net;
+using System.Net.Http.Json;
+using Microsoft.AspNetCore.Mvc.Testing;
+using UrlShortener.Application.Links;
+using UrlShortener.Presentation;
+
+namespace UrlShortener.IntegrationTests;
+
+public sealed class ClickCapTests(ShortenerApiFactory factory) : IClassFixture<ShortenerApiFactory>
+{
+    private readonly HttpClient _client = factory.CreateClient(new WebApplicationFactoryClientOptions { AllowAutoRedirect = false });
+
+    [Fact]
+    public async Task Capped_link_stops_redirecting_once_the_limit_is_reached()
+    {
+        var create = await _client.PostAsJsonAsync("/api/v1/links",
+            new CreateLinkRequest("https://example.com/once", $"cap-{Guid.NewGuid():N}"[..12], null, MaxClicks: 2));
+        var created = (await create.Content.ReadFromJsonAsync<CreatedShortLink>())!;
+
+        Assert.Equal(HttpStatusCode.Created, create.StatusCode);
+        Assert.Equal(2, created.Link.MaxClicks);
+
+        Assert.Equal(HttpStatusCode.Found, (await _client.GetAsync(new Uri(created.Link.Code, UriKind.Relative))).StatusCode);
+        Assert.Equal(HttpStatusCode.Found, (await _client.GetAsync(new Uri(created.Link.Code, UriKind.Relative))).StatusCode);
+
+        var deadline = DateTime.UtcNow.AddSeconds(10);
+        HttpStatusCode status;
+        do
+        {
+            await Task.Delay(100);
+            status = (await _client.GetAsync(new Uri(created.Link.Code, UriKind.Relative))).StatusCode;
+        }
+        while (status == HttpStatusCode.Found && DateTime.UtcNow < deadline);
+
+        Assert.Equal(HttpStatusCode.Gone, status);
+    }
+
+    [Fact]
+    public async Task Invalid_cap_is_rejected()
+    {
+        var response = await _client.PostAsJsonAsync("/api/v1/links", new CreateLinkRequest("https://example.com", null, null, MaxClicks: 0));
+
+        Assert.Equal(HttpStatusCode.BadRequest, response.StatusCode);
+    }
+
+    [Fact]
+    public async Task Uncapped_links_are_unchanged()
+    {
+        var response = await _client.PostAsJsonAsync("/api/v1/links", new CreateLinkRequest("https://example.com/free", null, null));
+        var created = (await response.Content.ReadFromJsonAsync<CreatedShortLink>())!;
+
+        Assert.Null(created.Link.MaxClicks);
+        Assert.Equal(HttpStatusCode.Found, (await _client.GetAsync(new Uri(created.Link.Code, UriKind.Relative))).StatusCode);
+    }
+
+    [Fact]
+    public async Task Owner_sees_the_cap_in_link_details()
+    {
+        var response = await _client.PostAsJsonAsync("/api/v1/links", new CreateLinkRequest("https://example.com/d", null, null, MaxClicks: 5));
+        var created = (await response.Content.ReadFromJsonAsync<CreatedShortLink>())!;
+        using var request = new HttpRequestMessage(HttpMethod.Get, $"/api/v1/links/{created.Link.Code}");
+        request.Headers.Add(LinkEndpoints.ManagementTokenHeader, created.ManagementToken);
+
+        var details = await (await _client.SendAsync(request)).Content.ReadFromJsonAsync<ShortLinkView>();
+
+        Assert.Equal(5, details!.MaxClicks);
+    }
+}

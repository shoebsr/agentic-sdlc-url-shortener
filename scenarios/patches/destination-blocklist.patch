@@ -0,0 +1,33 @@
+using UrlShortener.Application;
+
+namespace UrlShortener.UnitTests.Application;
+
+public class BlockedDomainTests
+{
+    private static ShortenerOptions Options()
+    {
+        var options = new ShortenerOptions();
+        options.BlockedDomains.Add("malware.example");
+        options.BlockedDomains.Add("phish.test");
+        return options;
+    }
+
+    [Theory]
+    [InlineData("malware.example")]
+    [InlineData("MALWARE.example")]
+    [InlineData("cdn.malware.example")]
+    [InlineData("deep.sub.phish.test")]
+    public void Blocked_domains_and_their_subdomains_are_rejected(string host)
+    {
+        Assert.True(Options().IsBlocked(host));
+    }
+
+    [Theory]
+    [InlineData("example.com")]
+    [InlineData("notmalware.example")]
+    [InlineData("malware.example.com")]
+    public void Lookalike_and_unrelated_domains_are_allowed(string host)
+    {
+        Assert.False(Options().IsBlocked(host));
+    }
+}

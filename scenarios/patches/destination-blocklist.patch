@@ -0,0 +1,37 @@
+using System.Net;
+using System.Net.Http.Json;
+using System.Text.Json;
+using Microsoft.AspNetCore.Hosting;
+using UrlShortener.Presentation;
+
+namespace UrlShortener.IntegrationTests;
+
+public sealed class BlockedDomainTests : IDisposable
+{
+    private readonly BlocklistFactory _factory = new();
+
+    [Fact]
+    public async Task Links_to_blocked_domains_are_rejected_with_a_stable_error_code()
+    {
+        var client = _factory.CreateClient();
+
+        var blocked = await client.PostAsJsonAsync("/api/v1/links", new CreateLinkRequest("https://login.malware.example/reset", null, null));
+        var allowed = await client.PostAsJsonAsync("/api/v1/links", new CreateLinkRequest("https://www.schwab.com", null, null));
+
+        Assert.Equal(HttpStatusCode.BadRequest, blocked.StatusCode);
+        using var problem = JsonDocument.Parse(await blocked.Content.ReadAsStringAsync());
+        Assert.Equal("url.blocked_domain", problem.RootElement.GetProperty("code").GetString());
+        Assert.Equal(HttpStatusCode.Created, allowed.StatusCode);
+    }
+
+    public void Dispose() => _factory.Dispose();
+
+    private sealed class BlocklistFactory : ShortenerApiFactory
+    {
+        protected override void ConfigureWebHost(IWebHostBuilder builder)
+        {
+            base.ConfigureWebHost(builder);
+            builder.UseSetting("Shortener:BlockedDomains:0", "malware.example");
+        }
+    }
+}

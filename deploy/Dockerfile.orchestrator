FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY global.json Directory.Build.props .editorconfig ./
COPY src/ src/
RUN dotnet restore src/Orchestrator/Orchestrator.Host \
 && dotnet publish src/Orchestrator/Orchestrator.Host -c Release -o /app --no-restore /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS runtime
WORKDIR /repo
COPY global.json Directory.Build.props .editorconfig AgenticSdlc.sln ./
COPY src/Shared src/Shared
COPY src/UrlShortener src/UrlShortener
COPY tests/UrlShortener.UnitTests tests/UrlShortener.UnitTests
COPY tests/UrlShortener.IntegrationTests tests/UrlShortener.IntegrationTests
COPY scenarios/ scenarios/
COPY --from=build /app /app

RUN mkdir -p /data && chown -R "$APP_UID" /data

ENV ASPNETCORE_URLS=http://+:8080 \
    Orchestrator__DataRoot=/data \
    Orchestrator__Workspace__SourceRoot=/repo \
    Orchestrator__Preview__BindHost=0.0.0.0 \
    Orchestrator__Preview__PublicHost=localhost \
    DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_NOLOGO=1

EXPOSE 8080 5100-5109
USER $APP_UID
WORKDIR /app
ENTRYPOINT ["dotnet", "/app/Orchestrator.Host.dll"]

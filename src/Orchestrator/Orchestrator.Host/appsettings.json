{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Orchestrator": {
    "Engine": {
      "MaxParallelNodes": 4,
      "AllowAutoApproval": false,
      "AutoApproveUpTo": "Low"
    },
    "Governance": {
      "MaxFilesWithoutReview": 12,
      "MaxLinesWithoutReview": 400,
      "MinimumPassRate": 100,
      "RequireSegregationOfDuties": true,
      "Approvers": [
        { "Name": "eng-lead", "Role": "Engineering Lead", "MaxRisk": "High" },
        { "Name": "security-officer", "Role": "Security Officer", "MaxRisk": "Critical" },
        { "Name": "product-owner", "Role": "Product Owner", "MaxRisk": "Medium" }
      ]
    },
    "Llm": {
      "Provider": "None",
      "Model": "claude-opus-5-5",
      "Effort": "medium",
      "ApiKeyEnvironmentVariable": "ANTHROPIC_API_KEY"
    }
  }
}

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Shortener": "Server=localhost;Database=UrlShortener;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=True"
  },
  "Database": {
    "Provider": "SqlServer",
    "InitializeOnStartup": false
  },
  "Shortener": {
    "PublicBaseUrl": "http://localhost:5080"
  },
  "RateLimits": {
    "RedirectPerMinute": 3000
  }
}

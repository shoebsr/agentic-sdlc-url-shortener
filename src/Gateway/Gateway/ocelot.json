{
  "Routes": [
    {
      "Key": "links",
      "UpstreamPathTemplate": "/api/v1/links/{everything}",
      "UpstreamHttpMethod": [ "Get", "Post", "Delete" ],
      "DownstreamPathTemplate": "/api/v1/links/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [ { "Host": "localhost", "Port": 5080 } ],
      "UpstreamHeaderTransform": { "X-Forwarded-For": "{RemoteIpAddress}" },
      "QoSOptions": { "TimeoutValue": 5000, "ExceptionsAllowedBeforeBreaking": 5, "DurationOfBreak": 10000 },
      "Priority": 2
    },
    {
      "Key": "links-root",
      "UpstreamPathTemplate": "/api/v1/links",
      "UpstreamHttpMethod": [ "Post" ],
      "DownstreamPathTemplate": "/api/v1/links",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [ { "Host": "localhost", "Port": 5080 } ],
      "UpstreamHeaderTransform": { "X-Forwarded-For": "{RemoteIpAddress}" },
      "QoSOptions": { "TimeoutValue": 5000, "ExceptionsAllowedBeforeBreaking": 5, "DurationOfBreak": 10000 },
      "Priority": 2
    },
    {
      "Key": "docs",
      "UpstreamPathTemplate": "/swagger/{everything}",
      "UpstreamHttpMethod": [ "Get" ],
      "DownstreamPathTemplate": "/swagger/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [ { "Host": "localhost", "Port": 5080 } ],
      "Priority": 2
    },
    {
      "Key": "openapi",
      "UpstreamPathTemplate": "/openapi/{everything}",
      "UpstreamHttpMethod": [ "Get" ],
      "DownstreamPathTemplate": "/openapi/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [ { "Host": "localhost", "Port": 5080 } ],
      "Priority": 2
    },
    {
      "Key": "redirect",
      "UpstreamPathTemplate": "/{code}",
      "UpstreamHttpMethod": [ "Get" ],
      "DownstreamPathTemplate": "/{code}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [ { "Host": "localhost", "Port": 5081 } ],
      "UpstreamHeaderTransform": { "X-Forwarded-For": "{RemoteIpAddress}" },
      "QoSOptions": { "TimeoutValue": 2000, "ExceptionsAllowedBeforeBreaking": 10, "DurationOfBreak": 5000 },
      "Priority": 0
    },
    {
      "Key": "ui",
      "UpstreamPathTemplate": "/ui/{everything}",
      "UpstreamHttpMethod": [ "Get" ],
      "DownstreamPathTemplate": "/ui/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [ { "Host": "localhost", "Port": 5080 } ],
      "Priority": 2
    },
    {
      "Key": "home",
      "UpstreamPathTemplate": "/",
      "UpstreamHttpMethod": [ "Get" ],
      "DownstreamPathTemplate": "/",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [ { "Host": "localhost", "Port": 5080 } ],
      "Priority": 2
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:5000"
  }
}

